# secrets — NFR-08：API key 絕不進 repo
.env
.env.*
# 前置斜線只排除 repo 根目錄下的 vault 目錄。寫成 secrets/ 會連
# pcmef/secrets/（secret_ref 抽象層的原始碼）一起吞掉，而那份程式碼必須進版控。
/secrets/
*.secret.json
**/opaque_map*.json

# 資料與產物
data/raw_real/
data/synthetic/
artifacts/
outputs/
*.npy
*.exr

# freeze 與 registry 由各 run 自行產生
freeze/*.lock.json
registry/*.db

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.venv/

provenance/*.json

outputs/

# E1-G06 的證據由 `pcmef e1 metrics-evidence` 產生。JUnit 報告帶機器專屬的
# 時間與路徑，進版控只會製造 diff 雜訊；證據要靠「跑一次」而不是「被提交過」。
tests/e1_metrics.xml
