# secrets — NFR-08：API key 絕不進 repo
.env
.env.*
# 但 .env.example 必須進版控 —— 它是範本，不含任何實際值，而它存在的
# 唯一理由就是讓接手的人 clone 之後看得到要設哪些變數。
# `.env.*` 原本把它一起吞掉：檔案只活在原作者的機器上，檔頭還寫著
# 「.env.example 會進版控」，而那句話是假的（與下面 secrets/ 那條同一類錯誤）。
!.env.example
# 前置斜線只排除 repo 根目錄下的 vault 目錄。寫成 secrets/ 會連
# pcmef/secrets/（secret_ref 抽象層的原始碼）一起吞掉，而那份程式碼必須進版控。
# master.key 與 vault.json 都在這個目錄下，因此都排除得到。
/secrets/
*.secret.json
**/opaque_map*.json

# 資料與產物
data/raw_real/
data/synthetic/
artifacts/
outputs/
*.npy
*.exr

# freeze 與 registry 由各 run 自行產生
freeze/*.lock.json
registry/*.db

# 但 freeze/amendments/ 必須進版控，且上面那條不得被擴大成 freeze/ 而吞掉它。
# lock 記錄「這次 run 用了什麼參數」，可以重產；
# amendment 記錄「判準本身被改過」，重產不出來 —— 它是協定的歷史。
# 判準改過幾次、每次凍結時的前提證據是什麼，只有版控留得住（NOTE-028）。
!freeze/amendments/
!freeze/amendments/*.amendment.json

# corrective run（freeze/runs/<id>/）的 lock 與延用的證據副本同理：
# 兩者都由 `corrective open-run` 重產得出。上面第一條只比對單層路徑，
# 因此 runs/ 底下必須另寫；少了它，更正 run 的 lock 會進版控而 parent 的
# 不會 —— 同一種東西兩種待遇，還會讓人以為版控裡那一份才是權威。
# 權威一律是 freeze/ 下的檔案本身，版控留的是產生它的程式與決策記錄。
freeze/runs/*/*.lock.json
freeze/runs/*/amendments/
freeze/runs/*/errata/
freeze/runs/*/preregistrations/
freeze/runs/*/stages/
freeze/runs/*/calibration/
# 但 lineage 記錄要留：它記的是「哪一個 identity 被 supersede、理由是什麼」，
# 與 amendment 同一類 —— 檔案重產得出來，當時的決策脈絡重產不出來。
!freeze/runs/*/corrective_lineage.json

# 本機開發工具設定。launch.json 寫死了直譯器名稱與埠號，是個別機器的東西；
# 用 Docker 接手的人拿到它只會困惑。刻意只忽略這一個檔而不是整個 .claude/，
# 將來若要共用 settings 或 agent 定義，那些仍然進得了版控。
.claude/launch.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.venv/

provenance/*.json

outputs/

# E1-G06 的證據由 `pcmef e1 metrics-evidence` 產生。JUnit 報告帶機器專屬的
# 時間與路徑，進版控只會製造 diff 雜訊；證據要靠「跑一次」而不是「被提交過」。
tests/e1_metrics.xml

# 平台化：每個專案自己的產出。專案「定義」(project.json) 要進版控，
# 專案「產物」不進 —— 與根目錄 outputs/ 同一個道理，只是換了位置。
# 既有的 outputs/ 規則是錨定在根目錄的，蓋不到 projects/<id>/outputs/。
projects/*/outputs/
projects/*/runs/
projects/*/artifacts/
projects/*/datasets/
projects/*/freeze/
