# PC-MEF Research System — 環境變數範本
# 檔案路徑: .env.example
# 產生時間: 2026-08-27 11:20 +08:00
# 版本: v0.1.0
#
# 複製成 .env 後填值。.env 已被 .gitignore 排除，不會進版控。
#   cp .env.example .env
#
# 維護提醒:
#   - 不得把實際值填進本檔（.env.example 會進版控）。
#   - 不得把 API key 直接寫進 .env；那只是換個地方存明文。
#     正確作法是在主控台上貼一次 key（系統加密後只留 vault:<uuid> 參考），
#     或把 key 放進你自己的環境變數、讓系統存 env:<NAME> 這個參考。
#   - 不得把 secrets/master.key 加入版控。它是 vault 的加密金鑰本身，
#     進了版控等於 vault 檔裡的密文全部失效。

# ---------------------------------------------------------------------------
# 網頁主控台（選填）
# ---------------------------------------------------------------------------
# 2026-08-31 起 `docker compose up console` **不再需要這一項**。compose 的
# ports 已把入口限縮成 127.0.0.1，並以 PCMEF_ADMIN_CONFINED_FORWARD 明確宣告，
# 對外沒有路由進得來，token 擋不到任何人。
#
# 只有把 console 真的開到區域網路時才需要它（那時還需要 TLS）。
# 設了的話，寫入端點就會要求帶上它。產生一個：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PCMEF_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# 本機加密 vault（選填）
# ---------------------------------------------------------------------------
# 2026-08-31 起**不再需要這一項**。沒設定時，主控台與 CLI 會自動在
# secrets/master.key 保管一把（該目錄已 gitignore；Docker 下在具名 volume 裡），
# 於是可以直接在網頁上貼 API key。
#
# 改掉的原因：沒設這個變數時 UI 的 API Key 欄位是灰的，操作者只剩
# env:<NAME> 一條路，而那個環境變數在容器裡同樣沒設 —— 憑證顯示
# (unresolvable)、Fetch 失敗、沒有線路鎖得起來、四個 agent 全部綁不上。
# 一顆沒人提示要設的變數，把整條 LLM 設定流程從頭鎖到尾。
#
# 這是 §46「master key 由環境供應、不由本系統產生」在本機單人主控台上的
# 明列例外，實作見 pcmef/secrets/vault.py 的 ensure_local_master_key()。
# 它**不是**退回明文保存：API key 一律仍以 Fernet 密文存在 vault 檔裡。
#
# 設了的話環境變數優先，secrets/master.key 完全不參與 ——
# 之後要接 KMS 或 OS keychain 走的就是這條。
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PCMEF_SECRET_MASTER_KEY=

# ---------------------------------------------------------------------------
# 離線示範用的假 provider（沒有真實憑證時，用它把整條流程走完）
# ---------------------------------------------------------------------------
# 格式：<model_id>:<cap>+<cap>,<model_id>:<cap>
# stub_offline 不在 FORMAL_ELIGIBLE_PROVIDERS 內 —— 流程走得完，但凍不進 formal。
PCMEF_STUB_MODELS=demo-omni:chat+vision+structured_json,demo-text:chat+structured_json

# ---------------------------------------------------------------------------
# 真實 provider 憑證（放在這裡只是為了讓容器讀得到；系統只存 env: 參考）
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# OPENAI_API_KEY=
