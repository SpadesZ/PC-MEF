    "objective": {
      "form": "J = sum over (class c, feature f) of w[c,f] * NW(real[c,f], sim[c,f])",
      "id": "NW_DISTRIBUTION_DISCREPANCY",
      "level": "distribution",
      "normalization": "s_f",
      "statistic": "wasserstein_w1",
      "weights": {
        "applies_to": "全部 4 classes x 4 features = 16 項",
        "fixed_before_seeing_data": true,
        "maintenance_bound": "變更權重必須開 amendment，不得在執行期以參數傳入。",
        "rationale": "NW 已經是無單位量，等權是唯一不需要額外辯護的選擇。任何非均勻權重 都會需要「為什麼這一類/這個特徵更重要」的理由，而在看過資料之後 才給得出的理由與挑一組讓結果好看的權重無法區分。\n",
        "scheme": "UNIFORM",
        "value": 1.0
      }
    },
    "optimizer": {
      "common_random_number_seeds": {
        "Bubbly": 1042,
        "Empty": 1001,
        "Misty": 1004,
        "Water-filled": 1002
      },
      "convergence": {
        "additional_requirement": "收斂當下的目標值必須優於該階段**起始**目標值；若最佳點就是起點， 該階段結論為 NO_IMPROVEMENT_REQUIRED，參數維持 initial 值。 這是合法且應該被記錄的結局，不是失敗。\n",
        "criterion": "differential_evolution 的標準收斂條件 （std(population energies) <= tol * |mean(population energies)|）， 或 scalar 階段的 xatol。\n",
        "non_convergence": {
          "is_legal_terminal_state": true,
          "outcome": "NOT_CONVERGED",
          "rule": "評估上限用盡而未達收斂條件時，記錄 best-so-far 但階段標記 NOT_CONVERGED，**且 calibrated_simulation 不得凍結**。 不得改用 best-so-far 並宣稱收斂，也不得為了收斂而放寬 tol 或邊界。\n"
        }
      },
      "failure_handling": {
        "failed_evaluation_budget": {
          "rule": "單一階段內失敗評估比例超過 20% 時，該階段標記 UNSTABLE_LANDSCAPE 並停止。 在一個五分之一都算不出來的地形上找到的最小值，不是最小值。\n",
          "threshold": 0.2
        },
        "forbidden_recovery": [
          "放寬邊界",
          "放寬 tol 或提高 max_evaluations 後重跑並只保留後者",
          "改變權重或 s_f",
          "改用「差不多就好」的收斂判定"
        ],
        "non_finite_objective": {
          "rule": "模擬崩潰、NaN、Inf 或非有限目標值一律回傳 +inf 並完整記錄該次評估的參數"
        },
        "simulator_crash": {
          "rule": "沿用 NOTE-012 的子行程隔離：崩潰只讓該次評估失敗，不讓整個階段中止， 但子行程的 exit code 必須完整記錄，不得吞掉。\n"
        }
      },
      "method_rule": "每個階段一律使用 scipy.optimize.differential_evolution，在該階段展開後的 全部維度上同時求解。不存在逐參數的純量搜尋路徑。\n",
      "multivariate": {
        "initialization": "Sobol 序列覆蓋整個邊界盒，另**強制**把 initial_simulation.lock 的 initial 值放進初始族群第 0 個個體 —— 這保證優化結果不會比凍結的起點更差, 且讓「資料沒有要求任何改變」是一個可達成的結局。\n",
        "maxiter": 100,
        "method": "scipy.optimize.differential_evolution",
        "options": {
          "init": "sobol",
          "mutation": [
            0.5,
            1.0
          ],
          "polish": false,
          "popsize": 15,
          "recombination": 0.7,
          "strategy": "best1bin",
          "tol": 0.01,
          "updating": "deferred"
        },
        "parallelism": "允許以 workers 平行化。`updating: deferred` 下平行與序列產生**相同**的 評估序列與相同的結果，因此平行化只影響時間，不影響科學。 若某次平行執行的 nfev 或最終參數與序列不同，該次執行作廢並必須查明原因。\n",
        "seed": 20260829
      },
      "optimizer_seed": 20260829,
      "restart": {
        "count": 3,
        "divergence_report": "三次重啟的最佳目標值若相對全距超過 0.05，必須在 artifact 中標記 MULTIMODAL 並記錄三組參數；這代表目標函數有多個近似等價的解， 是可辨識性的警訊而不是可以取平均的雜訊。\n",
        "policy": "FIXED_COUNT",
        "rule": "每階段以 seed_derivation 給定的三個種子各跑一次，取目標值最小者。 重啟次數事前固定，不得因為「再試一次可能更好」而追加。\n"
      },
      "seed_derivation": "重啟第 k 次使用 optimizer_seed + 1000*k，k 由 0 起算。 種子由公式決定而非逐次挑選，因此「換個種子直到結果好看」留得下痕跡。\n",
      "tie_break": {
        "epsilon": 0.001,
        "rationale": "資料分不出來的時候就不要動。initial model 是已凍結的參考點， 「最小位移」是唯一不需要引入新偏好的平手規則 —— 任何其他規則 （取較大值、取中點、取讓某一類好看的）都是在無資訊處注入選擇。\n",
        "rule": "兩組候選的目標值相對差小於 epsilon 時，取在**正規化邊界空間**中 離 initial 值 L2 距離較小的那一組。\n"
      },
      "verification_seeds": {
